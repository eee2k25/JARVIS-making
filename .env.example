# ── J.A.R.V.I.S. configuration ────────────────────────────────────────────
# Copy to .env and adjust. Every variable is optional.

# Cognitive pipeline — any OpenAI-compatible endpoint works:
#   OpenAI:     https://api.openai.com/v1          (model: gpt-4o-mini)
#   Groq:       https://api.groq.com/openai/v1     (model: llama-3.3-70b-versatile)
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1          (model: llama3.1, no key needed)
# Cognitive pipeline
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
JARVIS_LLM_API_KEY=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
JARVIS_LLM_MODEL=thinkingmachines/inkling-small:free 
JARVIS_LLM_TIMEOUT=30

# Data ingestion
JARVIS_HTTP_TIMEOUT=15
JARVIS_USER_AGENT=JARVIS-Agent/0.1 (+educational automation)

# Dynamic browser automation
JARVIS_HEADLESS=true
JARVIS_BROWSER_BINARY=
JARVIS_IMPLICIT_WAIT=0

# State machine resilience
JARVIS_MAX_RETRIES=3
JARVIS_BACKOFF_BASE=1.5
JARVIS_BACKOFF_JITTER=true

# GUI manipulation (PyAutoGUI)
JARVIS_GUI_FAILSAFE=true
JARVIS_GUI_PAUSE=0.1

# MS Office automation (Word / PowerPoint / Excel) — where generated
# .docx / .pptx / .xlsx artifacts land when no explicit path is given.
# App-engine verbs (export_pdf, launch) need Windows + MS Office + pywin32;
# elsewhere they log dry-run shadow actions.
JARVIS_OFFICE_OUTPUT_DIR=logs/office

# Operator identity — 'teach it who I am' (step 4). Plain markdown with
# name / work / goals / preferences / boundaries, injected into every LLM
# decision. Default: assets/profile/operator.md
JARVIS_OPERATOR_PROFILE=

# Long-term memory (step 5) — SQLite mission history fed back as few-shot
# context. Use ":memory:" for a throwaway store.
JARVIS_MEMORY_DB=logs/memory/jarvis.db

# Voice I/O (step 8) — ElevenLabs TTS/STT. Without a key, speak/transcribe
# log dry-run shadow actions. Pick any voice id you like (British optional).
JARVIS_ELEVENLABS_API_KEY=
JARVIS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
JARVIS_VOICE_MODEL=eleven_multilingual_v2
JARVIS_VOICE_OUTPUT_DIR=logs/voice

# Operations: auto | true | false
JARVIS_DRY_RUN=auto
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FILE=
